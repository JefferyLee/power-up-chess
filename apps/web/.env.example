# Copy to .env.local and fill in values from `firebase apps:sdkconfig WEB <appId>`.
# Firebase Web SDK config is intentionally shipped to clients; security is enforced
# by Auth + Firestore rules + Cloud Functions, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. When set, Firebase Analytics loads and logs key events
# (screen_view, game_start/end, puzzle_attempt, opening/endgame clears,
# host_commentary source). Leave blank in CI/tests to silence analytics.
# Get from `firebase apps:sdkconfig WEB`.
VITE_FIREBASE_MEASUREMENT_ID=

VITE_FUNCTIONS_REGION=us-central1

# Set to 1 to point the app at the local Firebase emulator suite.
VITE_USE_EMULATORS=0

# App Check (Phase 1.7) — reCAPTCHA v3 site key from Firebase console → App Check.
# Optional: when empty, App Check is skipped entirely.
VITE_APPCHECK_SITE_KEY=
