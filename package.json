{
  "name": "power-up-chess",
  "version": "0.0.0",
  "private": true,
  "description": "Chess learning game for Ada and other 8-10 year old learners.",
  "license": "UNLICENSED",
  "engines": {
    "node": "22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @power-up-chess/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore \"pnpm --filter @power-up-chess/functions test:rules\"",
    "e2e": "playwright test",
    "deploy:web": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "functions:lockfile": "tmp=$(mktemp -d) && cp functions/package.json functions/pnpm-lock.yaml \"$tmp\" && pnpm --dir \"$tmp\" install --lockfile-only --no-frozen-lockfile --ignore-workspace && cp \"$tmp/pnpm-lock.yaml\" functions/pnpm-lock.yaml"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.32.0"
  }
}
