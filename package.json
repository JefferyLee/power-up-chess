{
  "name": "power-up-chess",
  "version": "0.0.0",
  "private": true,
  "description": "Chess learning game for Ada and other 8-10 year old learners.",
  "license": "UNLICENSED",
  "engines": {
    "node": "22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @power-up-chess/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore \"pnpm --filter @power-up-chess/functions test:rules\"",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "firebase-tools": "15.9.1"
  }
}
