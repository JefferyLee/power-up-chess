{
  "name": "@power-up-chess/functions",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc && node scripts/bundle-stories.mjs",
    "build:watch": "tsc --watch",
    "generate-audio": "node scripts/generate-story-audio.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run -c vitest.rules.config.ts",
    "serve": "pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@google/generative-ai": "^0.24.1",
    "chess.js": "^1.4.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.5",
    "msedge-tts": "^2.0.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.12.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "firebase": "^12.14.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.7"
  }
}
