rules_version = '2';

// Power Up Chess Firestore security rules.
//
// Authoritative writes happen in Cloud Functions (service account, which
// bypasses these rules). Clients can only READ rooms they participate in,
// and never write moves directly — every move goes through the `submitMove`
// Cloud Function so chess.js can validate it server-side.

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // White is set at room creation, black is filled in by joinRoom.
      function isParticipant() {
        return request.auth != null && (
          request.auth.uid == resource.data.white.playerId ||
          (resource.data.black != null
            && request.auth.uid == resource.data.black.playerId)
        );
      }

      // Moves live as an array on the room doc itself (validated and appended
      // by the submitMove Cloud Function), so there is no moves subcollection.
      allow read: if isParticipant();
      allow write: if false;
    }

    // Commentary cache (host LLM output, keyed by hash). Read-only from clients;
    // Cloud Functions write through admin SDK.
    match /commentary/{hash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
