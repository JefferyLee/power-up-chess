rules_version = '2';

// Power Up Chess Firestore security rules.
//
// Authoritative writes happen in Cloud Functions (service account, which
// bypasses these rules). Clients can only READ rooms they participate in,
// and never write moves directly — every move goes through the `submitMove`
// Cloud Function so chess.js can validate it server-side.

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // Anyone authenticated with the link can READ a room. The security
      // boundary is the unguessable 6-char room id (~1B combinations), same
      // model as a Lichess game URL. This is what enables spectators to watch
      // a game by clicking a shared link.
      //
      // WRITES are still server-only — the submitMove / joinRoom / resignGame
      // Cloud Functions hold the only legitimate path to mutate room state,
      // and they enforce participant identity themselves.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Commentary cache (host LLM output, keyed by hash). Read-only from clients;
    // Cloud Functions write through admin SDK.
    match /commentary/{hash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // MVP2 Castle public stats — guest count + top-5 leaderboard.
    // PUBLIC read so the gate page can render before sign-in.
    // Rebuilt by a scheduled Cloud Function every 30 s.
    match /castle_public/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // MVP2 G.2 — castle gate "live pulse": duel count, recent duel
    // results, last host-story snippet. PUBLIC read for the gate page;
    // rebuilt every 2 min by refreshCastleLivePulse.
    match /castle_live/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Castle guests — holds magicWordHash, uids, castlePoints, puzzle
    // state, etc. Writes are always function-only (admin SDK).
    //
    // Reads: a signed-in user can read their OWN guest doc (uids array
    // contains their uid). This lets the Puzzle Garden subscribe to
    // puzzleRatings / puzzleCalibrated / puzzleDaily / puzzleStats and
    // react when the server updates them after calibration, a solve, or
    // a daily-five completion. No cross-guest reads — that path is
    // still server-mediated.
    match /guests/{normalizedName} {
      allow read: if request.auth != null
        && resource.data.uids.hasAny([request.auth.uid]);
      allow write: if false;
    }

    // Weekly tournament — public-ish read so any signed-in guest can
    // see registrations + (in later slices) standings. Writes only
    // via Cloud Functions (registerForTournament + future pairing /
    // result-reporting callables).
    match /tournaments/{weekKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-uid enter-attempt counters (rate limiting + 3-strike tracking).
    match /castle_enter_attempts/{uid} {
      allow read, write: if false;
    }
    match /castle_enter_attempts_daily/{key} {
      allow read, write: if false;
    }

    // Lobby chat — messages stream + presence.
    // READS allowed for any signed-in user (Hall is shared).
    // WRITES only via Cloud Functions (postChat + setPresence + scheduled).
    match /lobby/messages/items/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /lobby/presence/items/{sessionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Aggregate parent docs (so listCollections / onSnapshot at parent works
    // cleanly if needed). No data should live here; deny writes.
    match /lobby/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Chat identity shadow (uid → displayName mapping). Function-only.
    match /chat_identity/{uid} {
      allow read, write: if false;
    }

    // In-app feedback — written via submitFeedback, read only by the
    // dev (guests/jeff). Cross-doc lookup against guests/jeff lets the
    // Hall snapshot listener show new feedback live without a callable
    // round-trip. Writes are still function-only (no client tampering).
    match /feedback/{id} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/guests/jeff)
        && get(/databases/$(database)/documents/guests/jeff).data.uids.hasAny([request.auth.uid]);
      allow write: if false;
    }
    // Per-uid feedback rate-limit counters. Function-only.
    match /feedback_attempts/{uid} {
      allow read, write: if false;
    }

    // Chess invitations — READ allowed for the sender + recipient so each
    // side's onSnapshot listener can react to status transitions live.
    // WRITES are always function-only (sendInvite / respondInvite /
    // cancelInvite hold the only legitimate write paths; they enforce
    // the 5 CP debit + race-safe status transitions).
    match /invitations/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }
    // Per-uid invite send-rate counter (mirrors feedback_attempts).
    match /invite_attempts/{uid} {
      allow read, write: if false;
    }

    // Chat rate-limit counters. Function-only.
    match /chat_rate_limits/{doc} {
      allow read, write: if false;
    }

    // Ambient story scheduler state. Function-only.
    match /castle_ambient_state/{doc} {
      allow read, write: if false;
    }

    // Story-quiz answer keys (secret) and attempt counters. Function-only.
    // The user-visible quiz state (question, winner, explanation after
    // it's revealed) lives on the chat message itself.
    match /story_quiz_keys/{messageId} {
      allow read, write: if false;
    }
    match /story_quiz_cache/{storyId} {
      allow read, write: if false;
    }
    match /story_quiz_attempts/{messageId}/uids/{uid} {
      allow read, write: if false;
    }
    match /story_quiz_attempts/{messageId} {
      allow read, write: if false;
    }

    // Forest Adventure leaderboard — READ allowed for any signed-in guest so
    // the in-game side panel can render top scores. Writes are server-only.
    match /forest_leaderboard/{normalizedName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Forest run history per uid — function-only.
    match /forest_runs/{uid}/runs/{runId} {
      allow read, write: if false;
    }
    match /forest_runs/{uid} {
      allow read, write: if false;
    }

    // Wizard's Duel rooms — same security shape as chess rooms.
    // READ allowed for any signed-in user (so spectators / joiners can
    // load the room from a shared link). All WRITES go through the
    // submitWizardMove / submitWizardSpell / join / create Cloud
    // Functions, which enforce participant identity + game rules +
    // castle-points deduction atomically.
    match /wizard_rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Per-duel chat messages. READ open to any signed-in user (spectators
    // can read along), WRITE only via postWizardMessage Cloud Function
    // which enforces player-only posting + profanity + rate limits.
    match /wizard_rooms/{roomId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Per-duel chat rate-limit counters. Function-only.
    match /wizard_rooms/{roomId}/rate_limits/{uid} {
      allow read, write: if false;
    }

    // Spell pricing state (function-only). castle_spell_supply is the
    // shared daily pool; wizard_spell_quota tracks per-uid surges.
    match /castle_spell_supply/{spellId} {
      allow read, write: if false;
    }
    match /wizard_spell_quota/{key} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
