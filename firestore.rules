rules_version = '2';

// Power Up Chess Firestore security rules.
//
// Authoritative writes happen in Cloud Functions (service account, which
// bypasses these rules). Clients can only READ rooms they participate in,
// and never write moves directly — every move goes through the `submitMove`
// Cloud Function so chess.js can validate it server-side.

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomId} {
      // Anyone authenticated with the link can READ a room. The security
      // boundary is the unguessable 6-char room id (~1B combinations), same
      // model as a Lichess game URL. This is what enables spectators to watch
      // a game by clicking a shared link.
      //
      // WRITES are still server-only — the submitMove / joinRoom / resignGame
      // Cloud Functions hold the only legitimate path to mutate room state,
      // and they enforce participant identity themselves.
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Commentary cache (host LLM output, keyed by hash). Read-only from clients;
    // Cloud Functions write through admin SDK.
    match /commentary/{hash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // MVP2 Castle public stats — guest count + top-5 leaderboard.
    // PUBLIC read so the gate page can render before sign-in.
    // Rebuilt by a scheduled Cloud Function every 30 s.
    match /castle_public/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Castle guests — function-only. Holds magicWordHash, uids, castlePoints.
    // Clients never read this directly; castleEnter returns what they need.
    match /guests/{normalizedName} {
      allow read, write: if false;
    }

    // Per-uid enter-attempt counters (rate limiting + 3-strike tracking).
    match /castle_enter_attempts/{uid} {
      allow read, write: if false;
    }
    match /castle_enter_attempts_daily/{key} {
      allow read, write: if false;
    }

    // Lobby chat — messages stream + presence.
    // READS allowed for any signed-in user (Hall is shared).
    // WRITES only via Cloud Functions (postChat + setPresence + scheduled).
    match /lobby/messages/items/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /lobby/presence/items/{sessionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Aggregate parent docs (so listCollections / onSnapshot at parent works
    // cleanly if needed). No data should live here; deny writes.
    match /lobby/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Chat identity shadow (uid → displayName mapping). Function-only.
    match /chat_identity/{uid} {
      allow read, write: if false;
    }

    // Chat rate-limit counters. Function-only.
    match /chat_rate_limits/{doc} {
      allow read, write: if false;
    }

    // Ambient story scheduler state. Function-only.
    match /castle_ambient_state/{doc} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
